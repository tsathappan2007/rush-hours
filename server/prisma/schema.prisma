datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum StockMode {
  COUNTABLE
  SLOT_CAPACITY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PREPARING
  READY
  COLLECTED
  FORFEITED
  REFUNDED
}

enum StaffRole {
  MANAGER
  COUNTER_STAFF
}

// ----------------------------------------------------
// Models
// ----------------------------------------------------

model Canteen {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(20) // e.g. "MAIN-FC", "NORTH-CAN"
  description String?  @db.Text
  location    String?  @db.VarChar(150)
  openingTime String   @map("opening_time") @db.VarChar(10) // e.g. "08:00"
  closingTime String   @map("closing_time") @db.VarChar(10) // e.g. "20:00"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  menuItems MenuItem[]
  timeSlots TimeSlot[]
  staff     Staff[]
  orders    Order[]

  @@map("canteens")
}

model MenuItem {
  id          String    @id @default(uuid()) @db.Uuid
  canteenId   String    @map("canteen_id") @db.Uuid
  name        String    @db.VarChar(120)
  description String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  category    String    @db.VarChar(50) // e.g. "Breakfast", "Meals", "Snacks", "Beverages"
  imageUrl    String?   @map("image_url") @db.Text
  stockMode   StockMode @default(COUNTABLE) @map("stock_mode")
  isAvailable Boolean   @default(true) @map("is_available")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  canteen    Canteen     @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  stock      Stock?
  orderItems OrderItem[]

  @@index([canteenId, isAvailable])
  @@map("menu_items")
}

model Stock {
  id               String    @id @default(uuid()) @db.Uuid
  menuItemId       String    @unique @map("menu_item_id") @db.Uuid
  quantity         Int       @default(0) // Available countable stock (checked atomically)
  dailyTotal       Int       @default(0) @map("daily_total") // Prepared units for the day
  lastRestockedAt  DateTime  @default(now()) @map("last_restocked_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("stock")
}

model TimeSlot {
  id            String   @id @default(uuid()) @db.Uuid
  canteenId     String   @map("canteen_id") @db.Uuid
  slotDate      String   @map("slot_date") @db.VarChar(10) // YYYY-MM-DD
  startTime     String   @map("start_time") @db.VarChar(10) // e.g. "12:30"
  endTime       String   @map("end_time") @db.VarChar(10)   // e.g. "12:45"
  maxOrders     Int      @default(30) @map("max_orders")   // Maximum orders allowed in this slot
  currentOrders Int      @default(0) @map("current_orders") // Booked orders count
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  canteen Canteen @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([canteenId, slotDate, startTime, endTime])
  @@index([canteenId, slotDate])
  @@map("time_slots")
}

model Student {
  id           String   @id @default(uuid()) @db.Uuid
  rollNumber   String   @unique @map("roll_number") @db.VarChar(30)
  fullName     String   @map("full_name") @db.VarChar(100)
  email        String   @unique @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  orders Order[]

  @@map("students")
}

model Staff {
  id           String    @id @default(uuid()) @db.Uuid
  canteenId    String    @map("canteen_id") @db.Uuid
  staffCode    String    @unique @map("staff_code") @db.VarChar(30)
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         StaffRole @default(COUNTER_STAFF)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  canteen Canteen @relation(fields: [canteenId], references: [id], onDelete: Cascade)

  @@map("staff")
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  orderNumber        String      @unique @map("order_number") @db.VarChar(40) // e.g. "RH-2026-001"
  studentId          String      @map("student_id") @db.Uuid
  canteenId          String      @map("canteen_id") @db.Uuid
  timeSlotId         String?     @map("time_slot_id") @db.Uuid
  status             OrderStatus @default(PENDING_PAYMENT)
  totalAmount        Decimal     @map("total_amount") @db.Decimal(10, 2)
  razorpayOrderId    String?     @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId  String?     @map("razorpay_payment_id") @db.VarChar(100)
  paidAt             DateTime?   @map("paid_at")
  confirmedAt        DateTime?   @map("confirmed_at")
  readyAt            DateTime?   @map("ready_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // Relations
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  canteen     Canteen      @relation(fields: [canteenId], references: [id], onDelete: Restrict)
  timeSlot    TimeSlot?    @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  pickupToken PickupToken?

  @@index([canteenId, status])
  @@index([studentId, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  menuItemId     String   @map("menu_item_id") @db.Uuid
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  customizations String[] @default([])

  // Relations
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model PickupToken {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @unique @map("order_id") @db.Uuid
  otpCode    String    @map("otp_code") @db.VarChar(10) // 4-digit pickup code
  qrPayload  String    @map("qr_payload") @db.Text     // Encrypted/hashed token string
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([otpCode])
  @@map("pickup_tokens")
}
