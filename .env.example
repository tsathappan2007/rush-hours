# ==========================================
# RUSH HOURS - SHARED ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to `.env` in the root or in respective sub-packages as needed.

# ------------------------------------------
# Server Configuration (server/)
# ------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_STUDENT_URL=http://localhost:5173
CLIENT_CANTEEN_URL=http://localhost:5174

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rush_hours_db

# Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------
# Student Web App (student-app/)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ------------------------------------------
# Canteen Staff Portal (canteen-portal/)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
